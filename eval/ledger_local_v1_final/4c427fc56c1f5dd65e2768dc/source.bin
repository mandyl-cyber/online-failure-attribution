 requests.post(\n+        'http://program:8008/checkpoint',\n+        json={\"line\": 1},\n+        headers={\"Content-Type\": \"application/json\"},\n+        timeout=2\n+    )\n+    print(f\"Direct connection: Status {response.status_code}\")\n+    print(f\"Response: {response.text}\")\n+except Exception as e:\n+    print(f\"Direct connection failed: {type(e).__name__}: {e}\")\n+\n+print(\"\\n\" + \"=\"*50 + \"\\n\")\n+\n+# Test with proxy\n+print(\"Testing with proxy...\")\n+os.environ['http_proxy'] = 'http://oversea-squid2.ko.txyun:11080'\n+os.environ['https_proxy'] = 'http://oversea-squid2.ko.txyun:11080'\n+\n+try:\n+    response = requests.post(\n+        'http://program:8008/checkpoint',\n+        json={\"line\": 1},\n+        headers={\"Content-Type\": \"application/json\"},\n+        timeout=5\n+    )\n+    print(f\"With proxy: Status {response.status_code}\")\n+    print(f\"Response: {response.text}\")\n+except Exception as e:\n+    print(f\"With proxy failed: {type(e).__name__}: {e}\")\n+\n+print(\"\\n\" + \"=\"*50 + \"\\n\")\n+\n+# Try to resolve 'program'\n+print(\"Trying to resolve 'program'...\")\n+try:\n+    ip = socket.gethostbyname('program')\n+    print(f\"'program' resolves to: {ip}\")\n+\n+    # Try to connect to the IP directly\n+    sock = socket.socket()\n+    sock.settimeout(2)\n+    result = sock.connect_ex((ip, 8008))\n+    if result == 0:\n+        print(f\"Port 8008 is OPEN on {ip}\")\n+    else:\n+        print(f\"Port 8008 is CLOSED on {ip}\")\n+    sock.close()\n+except socket.gaierror as e:\n+    print(f\"Cannot resolve 'program': {e}\")\n+except Exception as e:\n+    print(f\"Error: {type(e).__name__}: {e}\")\n+\n+", "_diff_cache": null}}
