    serverless = new Serverless();\n    17\t    const options = {\n    18\t      stage: 'dev',\n    19\t      region: 'us-east-1',\n    20\t    };\n    21\t    serverless.setProvider('aws', new AwsProvider(serverless));\n    22\t    awsDeploy = new AwsDeploy(serverless, options);\n    23\t    awsDeploy.serverless.cli = new serverless.classes.CLI();\n    24\t    awsDeploy.serverless.service.provider.compiledCloudFormationTemplate = {\n    25\t      Resources: {},\n    26\t    };\n    27\t    awsDeploy.serverless.service.service = 'new-service';\n    28\t    awsDeploy.serverless.service.functions = {\n    29\t      [functionName]: {\n    30\t        name: 'test',\n    31\t        artifact: 'test.zip',\n    32\t        handler: 'handler.hello',\n    33\t      },\n    34\t    };\n    35\t  });\n    36\t\n    37\t  it('should not merge there are no functions', () => {\n    38\t    awsDeploy.serverless.service.functions = {};\n    39\t\n    40\t    return awsDeploy.mergeIamTemplates()\n    41\t      .then(() => {\n    42\t        const resources = awsDeploy.serverless.service.provider\n    43\t          .compiledCloudFormationTemplate.Resources;\n    44\t\n    45\t        expect(resources[awsDeploy.provider.naming.getRoleLogicalId()]).to.equal(undefined);\n    46\t        expect(resources[awsDeploy.provider.naming.getPolicyLogicalId()]).to.equal(undefined);\n    47\t      });\n    48\t  });\n    49\t\n    50\t  it('should merge the IamRoleLambdaExecution template into the CloudFormation template', () => {\n    51\t    const IamRoleLambdaExecutionTemplate = awsDeploy.serverless.utils.readFileSync(\n    52\t      path.join(\n    53\t        __dirname,\n    54\t        '..',\n    55\t        'lib',\n    56\t        'iam-role-lambda-execution-template.json'\n    57\t      )\n    58\t    );\n    59\t    IamRoleLambdaExecutionTemplate.Properties.Path = awsDeploy.provider.naming.getRolePath();\n    60\t    IamRoleLambdaExecutionTemplate.Properties.RoleName = awsDeploy.provider.naming.getRoleName();\n    61\t\n    62\t    return awsDeploy.mergeIamTemplates()\n    63\t      .then(() => {\n    64\t        expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n    65\t          .Resources[awsDeploy.provider.naming.getRoleLogicalId()]\n    66\t        ).to.deep.equal(\n    67\t          IamRoleLambdaExecutionTemplate\n    68\t        );\n    69\t      });\n    70\t  });\n    71\t\n    72\t  it('should merge IamPolicyLambdaExecution template into the CloudFormation template',\n    73\t    () => awsDeploy.mergeIamTemplates()\n    74\t      .then(() => {\n    75\t        // we check for the type here because a deep equality check will error out due to\n    76\t        // the updates which are made after the merge (they are tested in a separate test)\n    77\t        expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n    78\t          .Resources[awsDeploy.provider.naming.getPolicyLogicalId()]\n    79\t          .Type\n    80\t        ).to.deep.equal('AWS::IAM::Policy');\n    81\t      })\n    82\t  );\n    83\t\n    84\t  it('should update the necessary variables for the IamPolicyLambdaExecution',\n    85\t    () => awsDeploy.mergeIamTemplates()\n    86\t      .then(() => {\n    87\t        expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n    88\t          .Resources[awsDeploy.provider.naming.getPolicyLogicalId()]\n    89\t          .Properties\n    90\t          .PolicyName\n    91\t        ).to.eql(\n    92\t          {\n    93\t            'Fn::Join': [\n    94\t              '-',\n    95\t              [\n    96\t                awsDeploy.options.stage,\n    97\t                awsDeploy.serverless.service.service,\n    98\t                'lambda',\n    99\t              ],\n   100\t            ],\n   101\t          }\n   102\t        );\n   103\t      })\n   104\t  );\n   105\t\n   106\t  it('should add custom IAM policy statements', () => {\n   107\t    awsDeploy.serverless.service.provider.iamRoleStatements = [\n   108\t      {\n   109\t        Effect: 'Allow',\n   110\t        Action: [\n   111\t          'something:SomethingElse',\n   112\t        ],\n   113\t        Resource: 'some:aws:arn:xxx:*:*',\n   114\t      },\n   115\t    ];\n   116\t\n   117\t\n   118\t    return awsDeploy.mergeIamTemplates()\n   119\t      .then(() => {\n   120\t        expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   121\t          .Resources[awsDeploy.provider.naming.getPolicyLogicalId()]\n   122\t          .Properties\n   123\t          .PolicyDocument\n   124\t          .Statement[2]\n   125\t        ).to.deep.equal(awsDeploy.serverless.service.provider.iamRoleStatements[0]);\n   126\t      });\n   127\t  });\n   128\t\n   129\t  it('should add a CloudWatch LogGroup resource', () => {\n   130\t    awsDeploy.serverless.service.provider.cfLogs = true;\n   131\t    const normalizedName = awsDeploy.provider.naming.getLogGroupLogicalId(functionName);\n   132\t    return awsDeploy.mergeIamTemplates().then(() => {\n   133\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   134\t        .Resources[normalizedName]\n   135\t      ).to.deep.equal(\n   136\t        {\n   137\t          Type: 'AWS::Logs::LogGroup',\n   138\t          Properties: {\n   139\t            LogGroupName: awsDeploy.provider.naming.getLogGroupName(functionName),\n   140\t          },\n   141\t        }\n   142\t      );\n   143\t    });\n   144\t  });\n   145\t\n   146\t  it('should update IamPolicyLambdaExecution with a logging resource for the function', () => {\n   147\t    awsDeploy.serverless.service.provider.cfLogs = true;\n   148\t    awsDeploy.serverless.service.functions = {\n   149\t      func0: {\n   150\t        handler: 'func.function.handler',\n   151\t        name: 'func0',\n   152\t      },\n   153\t      func1: {\n   154\t        handler: 'func.function.handler',\n   155\t        name: 'func1',\n   156\t      },\n   157\t    };\n   158\t    const f = awsDeploy.serverless.service.functions;\n   159\t    const normalizedNames = [\n   160\t      awsDeploy.provider.naming.getLogGroupLogicalId(f.func0.name),\n   161\t      awsDeploy.provider.naming.getLogGroupLogicalId(f.func1.name),\n   162\t    ];\n   163\t    return awsDeploy.mergeIamTemplates().then(() => {\n   164\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   165\t        .Resources[normalizedNames[0]]\n   166\t      ).to.deep.equal(\n   167\t        {\n   168\t          Type: 'AWS::Logs::LogGroup',\n   169\t          Properties: {\n   170\t            LogGroupName: awsDeploy.provider.naming.getLogGroupName(f.func0.name),\n   171\t          },\n   172\t        }\n   173\t      );\n   174\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   175\t        .Resources[normalizedNames[1]]\n   176\t      ).to.deep.equal(\n   177\t        {\n   178\t          Type: 'AWS::Logs::LogGroup',\n   179\t          Properties: {\n   180\t            LogGroupName: awsDeploy.provider.naming.getLogGroupName(f.func1.name),\n   181\t          },\n   182\t        }\n   183\t      );\n   184\t    });\n   185\t  });\n   186\t\n   187\t  it('should update IamPolicyLambdaExecution with a logging resource for the function', () => {\n   188\t    awsDeploy.serverless.service.provider.cfLogs = true;\n   189\t    const normalizedName = awsDeploy.provider.naming.getLogGroupLogicalId(functionName);\n   190\t    return awsDeploy.mergeIamTemplates().then(() => {\n   191\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   192\t        .Resources[awsDeploy.provider.naming.getPolicyLogicalId()]\n   193\t        .Properties\n   194\t        .PolicyDocument\n   195\t        .Statement[0]\n   196\t        .Resource\n   197\t      ).to.deep.equal([{ 'Fn::GetAtt': [normalizedName, 'Arn'] }]);\n   198\t      expect(awsDeploy.serverless.service.pr