ment[1]\n   243\t        .Resource\n   244\t      ).to.deep.equal(\n   245\t        [\n   246\t          { 'Fn::Join': [':', [{ 'Fn::GetAtt': [normalizedNames[0], 'Arn'] }, '*']] },\n   247\t          { 'Fn::Join': [':', [{ 'Fn::GetAtt': [normalizedNames[1], 'Arn'] }, '*']] },\n   248\t        ]\n   249\t      );\n   250\t    });\n   251\t  });\n   252\t\n   253\t  it('should not add the default role and policy if all functions have an ARN role', () => {\n   254\t    awsDeploy.serverless.service.functions = {\n   255\t      func0: {\n   256\t        handler: 'func.function.handler',\n   257\t        name: 'new-service-dev-func0',\n   258\t        role: 'some:aws:arn:xx0:*:*',\n   259\t      },\n   260\t      func1: {\n   261\t        handler: 'func.function.handler',\n   262\t        name: 'new-service-dev-func1',\n   263\t        role: 'some:aws:arn:xx1:*:*',\n   264\t      },\n   265\t    };\n   266\t\n   267\t    awsDeploy.mergeIamTemplates().then(() => {\n   268\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   269\t        .Resources[awsDeploy.provider.naming.getPolicyLogicalId()]\n   270\t      ).to.equal(undefined);\n   271\t      expect(awsDeploy.serverless.service.provider.compiledCloudFormationTemplate\n   272\t        .Resources[awsDeploy.provider.naming.getRoleLogicalId()]\n   273\t      ).to.equal(undefined);\n   274\t    });\n   275\t  });\n   276\t\n   277\t  it('should not add default role / policy if all functions have an ARN role', () => {\n   278\t    awsDeploy.serverless.service.provider.role = 'some:aws:arn:xxx:*:*';\n   279\t    awsDeploy.serverless.service.functions = {\n   280\t      func0: {\n   281\t        handler: 'func.function.handler',\n   282\t        name: 'new-service-dev-func0',\n   283\t        // obtain role from provider\n   284\t      },\n   285\t      func1: {\n   286\t        handler: 'func.function.handler',\n   287\t        name: 'new-service-dev-func1',\n   288\t        role: 'some:aws: