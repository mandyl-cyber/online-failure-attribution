n        \\\"model\\\": base_model_name,\\n        \\\"lora_config\\\": {\\n            \\\"r\\\": lora_r,\\n            \\\"alpha\\\": lora_alpha,\\n            \\\"epochs\\\": epochs\\n        },\\n        \\\"training_samples\\\": len(train_dataset),\\n        \\\"validation_samples\\\": len(val_dataset)\\n    }\\n    \\n    info_path = os.path.join(output_dir, \\\"training_info.json\\\")\\n    with open(info_path, 'w') as f:\\n        json.dump(training_info, f, indent=2)\\n    \\n    logger.info(f\\\"Training info saved to {info_path}\\\")\\n    return training_info\\n\\nif __name__ == \\\"__main__\\\":\\n    # Parse command line arguments\\n    import argparse\\n    parser = argparse.ArgumentParser(description=\\\"Train LoRA adapter for biomedical QA\\\")\\n    parser.add_argument(\\\"--base_model\\\", default=\\\"openai-community/gpt2\\\", help=\\\"Base model name\\\")\\n    parser.add_argument(\\\"--train_path\\\", default=\\\"/app/data/train.json\\\", help=\\\"Path to training data\\\")\\n    parser.add_argument(\\\"--val_path\\\", default=\\\"/app/data/val.json\\\", help=\\\"Path to validation data\\\")\\n    parser.add_argument(\\\"--output_dir\\\", default=\\\"/app/experiments/lora_adapter\\\", help=\\\"Output directory\\\")\\n    parser.add_argument(\\\"--lora_r\\\", type=int, default=8, help=\\\"LoRA rank\\\")\\n    parser.add_argument(\\\"--lora_alpha\\\", type=int, default=16, help=\\\"LoRA alpha\\\")\\n    parser.add_argument(\\\"--epochs\\\", type=int, default=3, help=\\\"Number of epochs\\\")\\n    parser.add_argument(\\\"--batch_size\\\", type=int, default=4, help=\\\"Batch size\\\")\\n    parser.add_argument(\\\"--learning_rate\\\", type=float, default=5e-4, help=\\\"Learning rate\\\")\\n    parser.add_argument(\\\"--max_length\\\", type=int, default=512, help=\\\"Maximum sequence length\\\")\\n    \\n    args = parser.parse_args()\\n    \\n    # Train\\n    training_info = train_lora(\\n        base_model_name=args.base_model,\\n        train_p