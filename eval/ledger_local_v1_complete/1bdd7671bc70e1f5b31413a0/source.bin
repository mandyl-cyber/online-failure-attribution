,true,electronics,3,2023.03.25,25 March 2023\n    19\t4,101,150.00,true,food,1,2023-04-10,10 Apr 2023\n    20\t5,102,200.00,false,travel,2,2023/05/15,15-May-2023\n    21\t6,103,300.00,true,electronics,3,2023.06.20,20 June 2023\n    22\t\"\"\".strip()\n    23\t    )\n    24\t\n    25\t    # Use pandas 2.0 features for loading\n    26\t    df = pd.read_csv(\n    27\t        data,\n    28\t        dtype_backend=\"pyarrow\",\n    29\t        date_format=\"mixed\",  # New in pandas 2.0: handles multiple date formats\n    30\t    )\n    31\t\n    32\t    # Convert date columns using the new mixed format parser\n    33\t    date_cols = [\"transaction_date\", \"processing_date\"]\n    34\t    for col in date_cols:\n    35\t        if col in df.columns:\n    36\t            df[col] = pd.to_datetime(df[col], format=\"mixed\")\n    37\t\n    38\t    return df\n    39\t\n    40\t\n    41\tdata = io.StringIO(\n    42\t    \"\"\"\n    43\tid,name,value,valid\n    44\t1,John,10.5,true\n    45\t2,Jane,20.3,false\n    46\t3,,30.1,\n    47\t\"\"\".strip()\n    48\t)\n    49\t\n    50\tdf = pd.read_csv(data)\n    51\t\n    52\tprint(df)\n    53\t\n", "extras": {"path": "/app/src/data_loader.py", "impl_source": "oh_aci"}}
