type = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:308:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:344:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:366:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:391:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:404:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:428:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:514:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:548:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:585:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:633:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:687:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:773:        dtype: jnp.dtype = jnp.float32,\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:837:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:965:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/wav2vec2/modeling_flax_wav2vec2.py:1072:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:102:        # make sure we normalize float32 arrays\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:113:        # make sure array is in float32\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:114:        x = x.astype(np.float32)\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:207:            raw_speech = [np.asarray(speech, dtype=np.float32) for speech in raw_speech]\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:209:            raw_speech = np.asarray(raw_speech, dtype=np.float32)\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:211:            raw_speech = raw_speech.astype(np.float32)\nsrc/transformers/models/speech_to_text/feature_extraction_speech_to_text.py:236:            padded_inputs[\"input_features\"] = [np.asarray(feature, dtype=np.float32) for feature in input_features]\nsrc/transformers/models/vit/modeling_flax_vit.py:79:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:105:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:130:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:191:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:209:    dtype: jnp.dtype = jnp.float32\nsrc/transformers/models/vit/modeling_flax_vit.py:230:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:248:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:267:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:303:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:347:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\nsrc/transformers/models/vit/modeling_flax_vit.py:371:    dtype: jnp.dtype = jnp.float32  # the dtype of the computation\n[The command completed with exit code 0.]\n[Current working directory: /workspace/huggingface__transformers__8e908c8c74f556a82534f4cf1e7a1b4f7b