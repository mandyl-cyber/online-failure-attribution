\n    29\tlogger = logging.get_logger(__name__)\n    30\t\n    31\t\n    32\tclass Wav2Vec2FeatureExtractor(SequenceFeatureExtractor):\n    33\t    r\"\"\"\n    34\t    Constructs a Wav2Vec2 feature extractor.\n    35\t\n    36\t    This feature extractor inherits from\n    37\t    :class:`~transformers.feature_extraction_sequence_utils.SequenceFeatureExtractor` which contains most of the main\n    38\t    methods. Users should refer to this superclass for more information regarding those methods.\n    39\t\n    40\t    Args:\n    41\t        feature_size (:obj:`int`, defaults to 1):\n    42\t            The feature dimension of the extracted features.\n    43\t        sampling_rate (:obj:`int`, defaults to 16000):\n    44\t            The sampling rate at which the audio files should be digitalized expressed in Hertz per second (Hz).\n    45\t        padding_value (:obj:`float`, defaults to 0.0):\n    46\t            The value that is used to fill the padding values.\n    47\t        do_normalize (:obj:`bool`, `optional`, defaults to :obj:`False`):\n    48\t            Whether or not to zero-mean unit-variance normalize the input. Normalizing can help to significantly\n    49\t            improve the performance for some models, *e.g.*, `wav2vec2-lv60\n    50\t            <https://huggingface.co/models?search=lv60>`__.\n    51\t        return_attention_mask (:obj:`bool`, `optional`, defaults to :obj:`False`):\n    52\t            Whether or not :meth:`~transformers.Wav2Vec2FeatureExtractor.__call__` should return :obj:`attention_mask`.\n    53\t\n    54\t            .. note::\n    55\t\n    56\t                Wav2Vec2 models that have set ``config.feat_extract_norm == \"group\"``, such as `wav2vec2-base\n    57\t                <https://huggingface.co/facebook/wav2vec2-base-960h>`__, have **not** been trained using\n    58\t                :obj:`attention_mask`. For such models, :obj:`input_values` should simply be padded with 0 and no\n    59\t                :obj:`attention_mask` should be passed.\n    60\t\n    61\t                For Wav2Vec2 models that have set ``config.feat_extract_norm == \"layer\"``, such as `wav2vec2-lv60\n    62\t                <https://huggingface.co/facebook/wav2vec2-large-960h-lv60-self>`__, :obj:`attention_mask` should be\n    63\t                passed for batched inference.\n    64\t    \"\"\"\n    65\t\n    66\t    model_input_names = [\"input_values\", \"attention_mask\"]\n    67\t\n    68\t    def __init__(\n    69\t        self,\n    70\t        feature_size=1,\n    71\t        sampling_rate=16000,\n    72\t        padding_value=0.0,\n    73\t        return_attention_mask=False,\n    74\t        do_normalize=True,\n    75\t        **kwargs\n    76\t    ):\n    77\t        super().__init__(feature_size=feature_size, sampling_rate=sampling_rate, padding_value=padding_value, **kwargs)\n    78\t        self.return_attention_mask = return_attention_mask\n    79\t        self.do_normalize = do_normalize\n    80\t\n    81\t    @staticmethod\n    82\t    def zero_mean_unit_var_norm(\n    83\t        input_values: List[np.ndarray], attention_mask: List[np.ndarray], padding_value: float = 0.0\n    84\t    ) -> List[np.ndarray]:\n    85\t        \"\"\"\n    86\t        Every array in the list is normalized to have zero mean and unit variance\n    87\t        \"\"\"\n    88\t        if attention_mask is not None:\n    89\t            attention_mask = np.array(attention_mask, np.int32)\n    90\t            normed_input_values = []\n    91\t\n    92\t            for vector, length in zip(input_values, attention_mask.sum(-1)):\n    93\t                normed_slice = (vector - vector[:length].mean()) / np.sqrt(vector[:length].var() + 1e-7)\n    94\t                if length < normed_slice.shape[0]:\n    95\t                    normed_slice[length:] = padding_value\n    96\t\n    97\t                normed_input_values.append(normed_slice)\n    98\t        else:\n    99\t            normed_input_values = [(x - x.mean()) / np.sqrt(x.var() + 1e-7) for x in input_values]\n   100\t\n   101\t        return normed_input_values\n   102\t\n   103\t    def __call__(\n   104\t        self,\n   105\t        raw_speech: Union[np.ndarray, List[float], List[np.ndarray], List[List[float]]],\n   106\t        padding: Union[bool, str, PaddingStrategy] = False,\n   107\t        max_length: Optional[int] = None,\n   108\t        truncation: bool = False,\n   109\t        pad_to_multiple_of: Optional[int] = None,\n   110\t        return_attention_mask: Optional[bool] = None,\n   111\t        return_tensors: Optional[Union[str, TensorType]] = None,\n   112\t        sampling_rate: Optional[int] = None,\n   113\t        **kwargs\n   114\t    ) -> BatchFeature:\n   115\t        \"\"\"\n   116\t        Main method to featurize and prepare for the model one or several sequence(s). sequences.\n   117\t\n   118\t        Args:\n   119\t            raw_speech (:obj:`np.ndarray`, :obj:`List[float]`, :obj:`List[np.ndarray]`, :obj:`List[List[float]]`):\n   120\t                The sequence or batch of sequences to be padded. Each sequence can be a numpy array, a list of float\n   121\t                values, a list of numpy arrays or a list of list of float values.\n   122\t            padding (:obj:`bool`, :obj:`str` or :class:`~transformers.file_utils.PaddingStrategy`, `optional`, defaults to :obj:`False`):\n   123\t                Select a strategy to pad the returned sequences (according to the model's padding side and padding\n   124\t                index) among:\n   125\t\n   126\t                * :obj:`True` or :obj:`'longest'`: Pad to the longest sequence in the batch (or no padding if only a\n   127\t                  single sequence if provided).\n   128\t                * :obj:`'max_length'`: Pad to a maximum length specified with the argument :obj:`max_length` or to the\n   129\t                  maximum acceptable input length for the model if that argument is not provided.\n   130\t                * :obj:`False` or :obj:`'do_not_pad'` (default): No padding (i.e., can output a batch with sequences of\n   131\t                  different lengths).\n   132\t            max_length (:obj:`int`, `optional`):\n   133\t                Maximum length of the returned list and optionally padding length (see above).\n   134\t            truncation (:obj:`bool`):\n   135\t                Activates truncation to cut input sequences longer than `max_length` to `max_length`.\n   136\t            pad_to_multiple_of (:obj:`int`, `optional`):\n   137\t                If set will pad the sequence to a multiple of the provided value.\n   138\t\n   139\t                This is especially useful to enable the use of Tensor Cores on NVIDIA hardware with compute capability\n   140\t                >= 7.5 (Volta), or on TPUs which benefit from having sequence lengths be a multiple of 128.\n   141\t            return_attention_mask (:obj:`bool`, `optional`):\n   142\t                Whether to return the attention mask. If left to the default, will return the attention mask according\n   143\t                to the specific feature_extractor's default.\n   144\t\n   145\t                `What are attention masks? <../glossary.html#attention-mask>`__\n   146\t\n   147\t                .. note::\n   148\t\n   149\t                    Wav2Vec2 models that have set ``config.feat_extract_norm == \"group\"``, such as `wav2vec2-base\n   150\t                    <https://huggingface.co/facebook/wav2vec2-base-960h>`__, have **not** been trained using\n   151\t                    :obj:`attention_mask`. For such models, :obj:`input_values` should simply be padded with 0 and no\n   152\t                    :obj:`attention_mask` should be passed.\n   153\t\n   154\t                    For Wav2Vec2 models that have set ``config.feat_extract_norm == \"layer\"``, such as `wav2vec2-lv60\n   155\t                    <https://huggingface.co/facebook/wav2vec2-large-960h-lv60-self>`__, :obj:`attention_mask` should be\n   156\t                    passed for batched inference.\n   157\t\n   158\t            return_tensors (:obj:`str` or :class:`~transformers.file_utils.TensorType`, `optional`):\n   159\t                If set, will return tensors instead of list of python integers. Acceptable values are:\n   160\t\n   161\t                * :obj:`'tf'`: Return TensorFlow :obj:`tf.constant` objects.\n   162\t                * :obj:`'pt'`: Return PyTorch :obj:`torch.Tensor` objects.\n   163\t                * :obj:`'np'`: Return Numpy :obj:`np.ndarray` objects.\n   164\t            sampling_rate (:obj:`int`, `optional`):\n   165\t                The sampling rate at which the ``raw_speech`` input was sampled. It is strongly recommended to pass\n   166\t                ``sampling_rate`` at the forward call to prevent silent errors.\n   167\t            padding_value (:obj:`float`, defaults to 0.0):\n   168\t        \"\"\"\n   169\t\n   170\t        if sampling_rate is not None:\n   171\t            if sampling_rate != self.sampling_rate:\n   172\t                raise ValueError(\n   173\t                    f\"The model corresponding to this feature extractor: {self} was trained using a sampling rate of {self.sampling_rate}.\"\n   174\t                    f\"Please make sure that the provided `raw_speech` input was sampled with {self.sampling_rate} and not {sampling_rate}.\"\n   175\t                )\n   176\t        else:\n   177\t            logger.warning(\n   178\t                \"It is strongly recommended to pass the ``sampling_rate`` argument to this function.\"\n   179\t                \"Failing to do so can result in silent errors that might be hard to debug.\"\n   180\t            )\n   181\t\n   182\t        is_batched = bool(\n   183\t            isinstance(raw_speech, (list, tuple))\n   184\t            and (isinstance(raw_speech[0], np.ndarray) or isinstance(raw_speech[0], (tuple, list)))\n   185\t        )\n   186\t\n   187\t        # always return batch\n   188\t        if not is_batched:\n   189\t            raw_speech = [raw_speech]\n   190\t\n   191\t        # convert into correct format for padding\n   192\t        encoded_inputs = BatchFeature({\"input_values\": raw_speech})\n   193\t\n   194\t        padded_inputs = self.pad(\n   195\t            encoded_inputs,\n   196\t            padding=padding,\n   197\t            max_length=max_length,\n   198\t            truncation=truncation,\n   199\t            pad_to_multiple_of=pad_to_multiple_of,\n   200\t            return_attention_mask=return_attention_mask,\n   201\t        )\n   202\t\n   203\t        # convert input values to correct format\n   204\t        input_values = padded_inputs[\"input_values\"]\n   205\t        if not isinstance(input_values[0], np.ndarray):\n   206\t            padded_inputs[\"input_values\"] = [np.asarray(array, dtype=np.float32) for array in input_values]\n   207\t        elif (\n   208\t            not isinstance(input_values, np.ndarray)\n   209\t            and isinstance(input_values[0], np.ndarray)\n   210\t            and input_values[0].dtype is np.dtype(np.float64)\n   211\t        ):\n   212\t            padded_inputs[\"input_values\"] = [array.astype(np.float32) for array in input_values]\n   213\t        elif isinstance(input_values, np.ndarray) and input_values.dtype is np.dtype(np.float64):\n   214\t            padded_inputs[\"input_values\"] = input_values.astype(np.float32)\n   215\t\n   216\t        # convert attention_mask to correct format\n   217\t        attention_mask = padded_inputs.get(\"attention_mask\")\n   218\t        if attention_mask is not None:\n   219\t            padded_inputs[\"attention_mask\"] = [np.asarray(array, dtype=np.int32) for array in attention_mask]\n   220\t\n   221\t        # zero-mean and unit-variance normalization\n   222\t        if self.do_normalize:\n   223\t            attention_mask = (\n   224\t                attention_mask\n   225\t                if 