\nProof.\nintros x m e l Hx.\nreplace (radix_val beta) with (Zpower beta 1).\nnow apply inbetween_float_new_location.\napply Zmult_1_r.\nQed.\n\nTheorem inbetween_float_ex :\n  forall m e l,\n  exists x,", "extras": {"command": "sed -n '640,670p' flocq/Calc/Bracket.v", "metadata": {"exit_code": 0, "pid": -1, "username": "root", "hostname": "rack-ge107-ya-20250517193240", "working_dir": "/tmp/CompCert/CompCert-3.13.1", "py_interpreter_path": "", "prefix": "", "suffix": "\n[The command completed with exit code 0.]"}, "hidden": false}, "success": true}
