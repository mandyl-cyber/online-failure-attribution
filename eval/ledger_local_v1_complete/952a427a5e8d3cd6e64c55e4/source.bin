atrix.shape[0]:, -cm_matrix.shape[1]:] = 1  # BUG: sets all to 1\n    print(\"cright_buggy matrix (sets all to 1 - THIS IS THE BUG):\")\n    print(cright_buggy)\n    print()\n    \n    # Right side - FIXED VERSION \n    cright_fixed = np.zeros((noutp, cm_matrix.shape[1]))\n    cright_fixed[-cm_matrix.shape[0]:, -cm_matrix.shape[1]:] = cm_matrix  # FIX: preserves matrix\n    print(\"cright_fixed matrix (preserves separability info):\")\n    print(cright_fixed)\n    print()\n    \n    # Final result with bug\n    result_buggy = np.hstack([cleft, cright_buggy])\n    print(\"Final result with bug:\")\n    print(result_buggy)\n    print()\n    \n    # Final result with fix  \n    result_fixed = np.hstack([cleft, cright_fixed])\n    print(\"Final result with fix:\")\n    print(result_fixed)\n    print()\n    \n    # Expected result (what we get when not nesting)\n    expected = np.array([[True, True, False, False],\n                        [True, True, False, False], \n                        [False, False, True, False],\n                        [False, False, False, True]])\n    print(\"Expected result (Pix2Sky_TAN & Linear1D & Linear1D):\")\n    print(expected)\n    print()\n    \n    print(\"Fixed result matches expected:\", np.array_equal(result_fixed, expected))\n    print(\"Buggy result matches expected:\", np.array_equal(result_buggy, expected))\n\nif __name__ == \"__main__\":\n    simulate_separability_issue()\n", "old_str": null, "new_str": null, "insert_line": null, "content": "", "start": 1, "end": -1, "thought": "Let me create a simple test to verify my hypothesis without needing the full astropy installation:", "impl_source": "oh_aci"}}
