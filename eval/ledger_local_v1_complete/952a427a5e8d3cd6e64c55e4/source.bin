 they are as expected. Edit the file again if necessary.", "extras": {"path": "/app/astropy/astropy/modeling/tests/test_separable.py", "prev_exist": false, "old_content": "\n    with pytest.raises(ModelDefinitionError, match=r\"Unsupported operands for arithmetic operator: .*\"):\n        _arith_oper(sh1, map1)\n\n\n\n", "new_content": "\n    with pytest.raises(ModelDefinitionError, match=r\"Unsupported operands for arithmetic operator: .*\"):\n        _arith_oper(sh1, map1)\n\n\n@pytest.mark.parametrize(('compound_model', 'result'), compound_models.values())\ndef test_separable(compound_model, result):\n    assert_allclose(is_separable(compound_model), result[0])\n    assert_allclose(separability_matrix(compound_model), result[1])\n\n\ndef test_nested_compound_model_separability():\n    \"\"\"\n    Test that nested compound models compute separability correctly.\n    \n    This is a regression test for issue where separability_matrix incorrectly\n    computed separability for nested CompoundModels like:\n    Pix2Sky_TAN() & (Linear1D(10) & Linear1D(5))\n    \n    The issue was that the _cstack function was setting all values to 1 instead\n    of preserving the separability matrix from nested compound models.\n    \"\"\"\n    # Create the basic compound model: Linear1D & Linear1D\n    cm = models.Linear1D(10) & models.Linear1D(5)\n    \n    # Test that it has correct separability (should be diagonal)\n    expected_cm = np.array([[True, False], [False, True]])\n    assert_allclose(separability_matrix(cm), expected_cm)\n    \n    # Create complex model: Pix2Sky_TAN & Linear1D & Linear1D\n    complex_model = models.Pix2Sky_TAN() & models.Linear1D(10) & models.Linear1D(5)\n    expected_complex = np.array([[True, True, False, False],\n                                [True, True, False, False], \n                                [False, False, True, False],\n                                [False, False, False, True]])\n    assert_allclose(separability_matrix(complex_model), expected_complex)\n    \n    # Create nested model: Pix2Sky_TAN & (Linear1D & Linear1D)\n    # This should have the same result as the complex model\n    nested_model = models.Pix2Sky_TAN() & cm\n    nested_result = separability_matrix(nested_model)\n    \n    # The key test: nested should equal complex (this was failing before the fix)\n    assert_allclose(nested_result, expected_complex,\n                    err_msg=\"Nested compound model separability should match \"\n                           \"non-nested equivalent\")\n    \n    # Also test that the last two rows are properly diagonal (separable)\n    # This verifies that the Linear1D models remain independent\n    assert nested_result[2, 2] == True and nested_result[2, 3] == False\n    assert nested_result[3, 2] == False and nested_result[3, 3] == True\n\n\ndef test_custom_model_separable():\n    @custom_model\n    def model_a(x):\n        return x\n\n    assert model_a().separable\n\n    @custom_model\n    def model_c(x, y):\n        return x + y\n\n    assert not model_c().separable\n    assert np.all(separability_matrix(model_c()) == [True, True])\n", "impl_source": "oh_aci", "diff": "--- /app/astropy/astropy/modeling/tests/test_separable.py\n+++ /app/astropy/astropy/modeling/tests/test_separable.py\n@@ -131,0 +132,4 @@\n+@pytest.mark.parametrize(('compound_model', 'result'), compound_models.values())\n+def test_separable(compound_model, result):\n+    assert_allclose(is_separable(compound_model), result[0])\n+    assert_allclose(separability_matrix(compound_model), result[1])\n@@ -133,0 +138,56 @@\n+def test_nested_compound_model_separability():\n+    \"\"\"\n+    Test that nested compound models compute separability correctly.\n+\n+    This is a regression test for issue where separability_matrix incorrectly\n+    computed separability for nested CompoundModels like:\n+    Pix2Sky_TAN() & (Linear1D(10) & Linear1D(5))\n+\n+    The issue was that the _cstack function was setting all values to 1 instead\n+    of preserving the separability matrix from nested compound models.\n+    \"\"\"\n+    # Create the basic compound model: Linear1D & Linear1D\n+    cm = models.Linear1D(10) & models.Linear1D(5)\n+\n+    # Test that it has correct separability (should be diagonal)\n+    expected_cm = np.array([[True, False], [False, True]])\n+    assert_allclose(separability_matrix(cm), expected_cm)\n+\n+    # Create complex model: Pix2Sky_TAN & Linear1D & Linear1D\n+    complex_model = models.Pix2Sky_TAN() & models.Linear1D(10) & models.Linear1D(5)\n+    expected_complex = np.array([[True, True, False, False],\n+                                [True, True, False, False],\n+                                [False, False, True, False],\n+                                [False, False, False, True]])\n+    assert_allclose(separability_matrix(complex_model), expected_complex)\n+\n+    # Create nested model: Pix2Sky_TAN & (Linear1D & Linear1D)\n+    # This should have the same result as the complex model\n+    nested_model = models.Pix2Sky_TAN() & cm\n+    nested_result = separability_matrix(nested_model)\n+\n+    # The key test: nested should equal complex (this was failing before the fix)\n+    assert_allclose(nested_result, expected_complex,\n+                    err_msg=\"Nested compound model separability should match \"\n+                           \"non-nested equivalent\")\n+\n+    # Also test that the last two rows are properly diagonal (separable)\n+    # This verifies that the Linear1D models remain independent\n+    assert nested_result[2, 2] == True and nested_result[2, 3] == False\n+    assert nested_result[3, 2] == False and nested_result[3, 3] == True\n+\n+\n+def test_custom_model_separable():\n+    @custom_model\n+    def model_a(x):\n+        return x\n+\n+    assert model_a().separable\n+\n+    @custom_model\n+    def model_c(x, y):\n+        return x + y\n+\n+    assert not model_c().separable\n+    assert np.all(separability_matrix(model_c()) == [True, True])\n+",