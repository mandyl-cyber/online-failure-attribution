lp_text,\nlib/ansible/plugins/inventory/script.py:385:            help_text=stderr_help_text,\nlib/ansible/plugins/inventory/script.py:391:    return data, stderr, stderr_help_text\nlib/ansible/plugins/lookup/first_found.py:168:                help_text=f'Provide a list of paths for {target} instead.',\nlib/ansible/plugins/action/__init__.py:1235:            help_text = \"\"\nlib/ansible/plugins/action/__init__.py:1246:                    help_text = 'Consider overriding the configured interpreter path for this host. '\nlib/ansible/plugins/action/__init__.py:1257:                    help_text=help_text + \"See stdout/stderr for the returned output.\",\nlib/ansible/plugins/cache/base.py:26:    help_text=\"Import from `ansible.plugins.cache` instead.\",\nlib/ansible/config/manager.py:669:                                              help_text=f'Valid values are: {valid}')\nlib/ansible/parsing/ajson.py:15:#     help_text=\"\",  # DTFIX-RELEASE: complete this help text\nlib/ansible/parsing/yaml/objects.py:50:        #     help_text=\"Instances of this type cannot be created and will not be encountered.\",\nlib/ansible/parsing/dataloader.py:176:            help_text = 'This file must be UTF-8 encoded.'\nlib/ansible/parsing/dataloader.py:178:            help_text = 'Ensure the correct encoding was specified.'\nlib/ansible/parsing/dataloader.py:189:                help_text=help_text,\nlib/ansible/module_utils/basic.py:1389:        #     # help_text=\"\",  # DTFIX-RELEASE: fill in this help text\nlib/ansible/module_utils/datatag.py:17:    help_text: str | None = None,\nlib/ansible/module_utils/datatag.py:35:        help_text=help_text,\nlib/ansible/module_utils/_internal/_json/_profiles/__init__.py:389:        help_text=f'This check can be disabled with the `{_check_encoding_setting}` setting.',\nlib/ansible/module_utils/_internal/_datatag/_tags.py:14:    help_text: t.Optional[str] = None\nlib/ansible/module_utils/common/validation.py:587:    #     help_text=\"JSON string 