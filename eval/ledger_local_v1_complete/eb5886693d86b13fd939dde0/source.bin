# 2. Some probabilities much lower than uniform\\n    \\n    # Let's try a power-law like distribution\\n    # First, let's solve for a simpler case: what if we have just two types of probabilities?\\n    # - k elements with high probability p_high\\n    # - (V-k) elements with low probability p_low\\n    \\n    # The constraints are:\\n    # k * p_high + (V-k) * p_low = 1\\n    # KL(P||U) = k * p_high * log(p_high * V) + (V-k) * p_low * log(p_low * V) = target_kl\\n    # KL(U||P) = k * (1/V) * log(1/(V * p_high)) + (V-k) * (1/V) * log(1/(V * p_low)) = target_kl\\n    \\n    # This is still complex. Let me try a different approach.\\n    # Let's use the fact that for uniform distribution: KL(P||U) = H(U) - H(P) + log(V)\\n    # where H is entropy.\\n    \\n    # Try a parametric approach: exponential distribution in log space\\n    \\n    best_dist = None\\n    best_error = float('inf')\\n    \\n    # Try different numbers of \\\"peaked\\\" elements\\n    for k in [1, 2, 5, 10, 20, 50, 100, min(1000, vocab_size // 10)]:\\n        if k >= vocab_size:\\n            continue\\n            \\n        # Try different concentration levels\\n        for alpha in np.logspace(0, 4, 20):  # from 1 to 10000\\n            \\n            # Create distribution: k elements get high prob, rest get low prob\\n            p = np.ones(vocab_size) * (1.0 / vocab_size)  # Start uniform\\n            \\n            # Concentrate probability on first k elements\\n            high_prob = alpha / vocab_size\\n            low_prob = (1.0 - k * high_prob) / (vocab_size - k)\\n            \\n            if high_prob <= 0 or low_prob <= 0 or high_prob > 1:\\n                continue\\n                \\n            p[:k] = high_prob\\n            p[k:] = low_prob\\n            \\n            # Normalize just to be safe\\n            p = p / np.sum(p)\\n            \\n            if not np.all(p > 0):\\n                continue\\n            \\n            u = np.ones(vocab_size) / vocab_size\\n            fkl = forward_kl(p, u)\\n            bkl = backward_kl(p, u)\\n            \\n            error = abs(fkl - target_kl) + abs(bkl - target_kl)\\n            \\n            if error < best_error:\\n                best_error = error\\n                best_dist = p.copy()\\n                best_fkl = fkl\\n                best_bkl = bkl\\n                \\n                # Print if we found a good solution\\n                if error < 0.1:\\n                    print(f\\\"Good candidate: k={k}, alpha={alpha:.2f}\\\")\\n                    print(f\\\"  Forward KL: {fkl:.3f}, Backward KL: {bkl:.3f}\\\")\\n                    print(f\\\"  Error: {error:.6f}\\\")\\n    \\n    return best_dist, best_fkl, best_bkl\\n\\ndef create_exponential_distribution(vocab_size, target_kl=10.0):\\n    \\\"\\\"\\\"Try creating an exponential-like distribution\\\"\\\"\\\"\\n    \\n    best_dist = None\\n    best_error = float('inf')\\n    \\n    # Try different decay rates for exponential distribution\\n    for decay_rate in np.logspace(-3, 2, 50):  # From 0.001 to 100\\n        \\n        # Create exponential distribution\\n        indices = np.arange(vocab_size)\\n        log_probs = -decay_rate * indices\\n        \\n        # Convert to probabilities\\n        p = np.exp(log_probs)\\n        p = p / np.sum(p)\\n        \\n        u = np.ones(vocab_size) / vocab_size\\n        fkl = forward_kl(p, u)\\n        bkl = backward_kl(p, u)\\n        \\n        error = abs(fkl - target_kl) + abs(bkl - target_kl)\\n        \\n        if error < best_error:\\n            best_error = error\\n            best_dist = p.copy()\\n            best_fkl = fkl\\n            best_bkl = bkl\\n            \\n            if error < 0.1:\\n                print(f\\\"Exponential candidate: decay={decay_rate:.4f}\\\")\\n                print(f\\\"  Forward KL: {fkl:.3f}, Backward KL: {bkl:.3f}\\\")\\n                print(f\\\"  Error: {error:.6f}\\\")\\n    \\n    return best_dist, best_fkl, best_bkl\\n\\ndef find_target_distribution(vocab_size=150000, target_kl=10.0, tolerance=0.001):\\n    \\\"\\\"\\\"Find target distribution using analytical approaches\\\"\\\"\\\"\\n    \\n    print(f\\\"Finding analytical solution for vocab_size={vocab_size}, target_kl={target_kl}\\\")\\n    print(f\\\"Tolerance: {tolerance}\\\")\\n    \\n    # Try different analytical approaches\\n    approaches = [\\n        (\\\"Two-level distribution\\\", create_analytical_distribution),\\n        (\\\"Exponential distribution\\\", create_exponential_distribution),\\n    ]\\n    \\n    best_solution = None\\n    best_error = float('inf')\\n    \\n    for name, method in approaches:\\n        print(f\\\"\\\\nTrying {name}...\\\")\\n        \\n        dist, fkl, bkl = method(vocab_size, target_kl)\\n        \\n        if dist is not None:\\n            fkl_error = abs(fkl - target_kl)\\n            bkl_error = abs(bkl - target_kl)\\n            total_error = fkl_error + bkl_error\\n            \\n            print(f\\\"  Forward KL: {fkl:.6f} (error: {fkl_error:.6f})\\\")\\n            print(f\\\"  Backward KL: {bkl:.6f} (error: {bkl_error:.6f})\\\")\\n            print(f\\\"  Total error: {total_error:.6f}\\\")\\n            \\n            if total_error < best_error:\\n                best_error = total_error\\n                best_solution = (dist, fkl, bkl)\\n                \\n                if fkl_error <= tolerance and bkl_error <= tolerance:\\n                    print(f\\\"Found solution within tolerance!\\\")\\n                    break\\n    \\n    if best_solution is None:\\n        print(\\\"No valid solution found\\\")\\n        return None, 0, 0\\n        \\n    p, fkl, bkl = best_solution\\n    \\n    print(f\\\"\\\\n\\\" + \\\"=\\\"*50)\\n    print(f\\\"FINAL RESULTS:\\\")\\n    print(f\\\"Forward KL divergence: {fkl:.6f}\\\")\\n    print(f\\\"Backward KL divergence: {bkl:.6f}\\\")\\n    print(f\\\"Target: {target_kl}\\\")\\n    print(f\\\"Forward error: {abs(fkl - target_kl):.6f}\\\")\\n    print(f\\\"Backward error: {abs(bkl - target_kl):.6f}\\\")\\n    print(f\\\"Within tolerance: {abs(fkl - target_kl) <= tolerance and abs(bkl - target_kl) <= tolerance}\\\")\\n    \\n    # Verify it's a valid probability distribution\\n    print(f\\\"\\\\nDistribution properties:\\\")\\n    print(f\\\"Sum of probabilities: {np.sum(p):.10f}\\\")\\n    print(f\\\"All probabilities >= 0: {np.all(p >= 0)}\\\")\\n    print(f\\\"Max probability: {np.max(p):.6f}\\\")\\n    print(f\\\"Min probability: {np.min(p):.10f}\\\")\\n    print(f\\\"Number of very small probabilities: {np.sum(p < 1e-10)}\\\")\\n    \\n    return p, fkl, bkl\\n\\nif __name__ == \\\"__main__\\\":\\n    # Test with small vocabulary first\\n    print(\\\"=\\\" * 50)\\n    print(\\\"Testing analytical approach with small vocabulary (V=10)\\\")\\n    print(\\\"=\\\" * 50)\\n    test_dist, test_fkl, test_bkl = find_target_distribution(vocab_size=10, target_kl=10.0)\\n    \\n    tolerance = 0.001\\n    target_kl = 10.0\\n    \\n    if test_dist is not None and abs(test_fkl - target_kl) <= tolerance and abs(test_bkl - target_kl) <= tolerance:\\n        print(\\\"Small test succeeded! Proceeding with full vocabulary...\\\")\\n        \\n        print(\\\"\\\\n\\\" + \\\"=\\\" * 50)\\n        print(\\\"Finding target distribution (V=150,000)\\\")\\n        print(\\\"=\\\" * 50)\\n        \\n        # Find the target distribution\\n        distribution, fkl, bkl = find_target_distribution()\\n        \\n        if distribution is not None and abs(fkl - target_kl) <= tolerance and abs(bkl - target_kl) <= tolerance:\\n            print(f\\\"\\\\nSuccess! Found distribution within tolerance.\\\")\\n            # Save the distribution\\n            np.save('/app/dist.npy', distribution)\\n            print(\\\"Distribution saved to /app/dist.npy\\\")\\n        else:\\n            print(f\\\"\\\\nFailed to find distribution within tolerance for large vocabulary.\\\")\\n            if distribution is not None:\\n                print(f\\\"Best errors - Forward: {abs(fkl - target_kl):.6f}, Backward: {abs(bkl - target_kl):.6f}\\\")\\n    else:\\n        print(\\\"Small test failed with analytical approach.\\\")\\n        if test_dist is not None:\\n            print(f\\\"Forward KL error: {abs(test_fkl - target_kl):.6f}\\\")\\n            print(f\\\"Backward KL error: {abs(test_bkl - target_kl):.6f}\\\")\\n\\n\"}", "name": "str_replace_editor"}, "id": "toolu_20", "type": "function"}], "function_call": null}, "provider_specific_fields": {}}], "usage": {"completion_tokens": 2937, "prompt_tokens": 22768, "total_tokens": 25705, "completion_tokens_details": null, "prompt_tokens_details": {"audio_tokens": null, "cached_tokens": 0, "text_tokens": null, "image_tokens": null}, "extra_tokens_details": {"CacheCreationInputTokens": 22765}}, "service_tier": null}, "total_calls_in_response": 1}, "content": "File created successfully at: /app/analytical_solution.py", "extras": {"path": "/app/analytical_solution.py", "prev_exist": false, "old_content": null, "new_content": null, "impl_source": "oh_aci", "diff": "--- /app/analytical_solution.py\n+++ /app/analytical_solution.py\n@@ -1,0 +2,229 @@\n+import numpy as np\n+import math\n+\n+def forward_kl(p, u):\n+    \"\"\"Calculate KL(P||U) = Σ P(i) * log(P(i) / U(i))\"\"\"\n+    epsilon = 1e-15\n+    p_safe = np.maximum(p, epsilon)\n+    u_safe = np.maximum(u, epsilon)\n+    return np.sum(p * np.log(p_safe / u_safe))\n+\n+def backward_kl(p, u):\n+    \"\"\"Calculate KL(U||P) = Σ U(i) * log(U(i) / P(i))\"\"\"\n+    epsilon = 1e-15\n+    p_safe = np.maximum(p, epsilon)\n+    u_safe = np.maximum(u, epsilon)\n+    return np.sum(u * np.log(u_safe / p_safe))\n+\n+def create_analytical_distribution(vocab_size, target_kl=10.0):\n+    \"\"\"\n+    Create a distribution analytically based on the constraint.\n+\n+    For both KL divergences to be equal to target_kl, we need a specific structure.\n+    Let's try a distribution where most probability mass is concentrated on a few elements.\n+    \"\"\"\n+\n+    # Start with the insight that for high KL divergences, we need:\n+    # 1. Some probabilities much higher than uniform (1/V)\n+    # 2. Some probabilities much lower than uniform\n+\n+    # Let's try a power-law like distribution\n+    # First, let's solve for a simpler case: what if we have just two types of probabilities?\n+    # - k elements with high probability p_high\n+    # - (V-k) elements with low probability p_low\n+\n+    # The constraints are:\n+    # k * p_high + (V-k) * p_low = 1\n+    # KL(P||U) = k * p_high * log(p_high * V) + (V-k) * p_low * log(p_low * V) = target_kl\n+    # KL(U||P) = k * (1/V) * log(1/(V * p_high)) + (V-k) * (1/V) * log(1/(V * p_low)) = target_kl\n+\n+    # This is still complex. Let me try a different approach.\n+    # Let's use the fact that for uniform distribution: KL(P||U) = H(U) - H(P) + log(V)\n+    # where H is entropy.\n+\n+    # Try a parametric approach: exponential distribution in log space\n+\n+    best_dist = None\n+    best_error = float('inf')\n+\n+    # Try different numbers of \"peaked\" elements\n+    for k in [1, 2, 5, 10, 20, 50, 100, min(1000, vocab_size // 10)]:\n+        if k >= vocab_size:\n+            continue\n+\n+        # Try different concentration levels\n+        for alpha in np.logspace(0, 4, 20):  # from 1 to 10000\n+\n+            # Create distribution: k elements get high prob, rest get low prob\n+            p = np.ones(vocab_size) * (1.0 / vocab_size)  # Start uniform\n+\n+            # Concentrate probability on first k elements\n+            high_prob = alpha / vocab_size\n+            low_prob = (1.0 - k * high_prob) / (vocab_size - k)\n+\n+            if high_prob <= 0 or low_prob <= 0 or high_prob > 1:\n+                continue\n+\n+            p[:k] = high_prob\n+            p[k:] = low_prob\n+\n+            # Normalize just to be safe\n+            p = p / np.sum(p)\n+\n+            if not np.all(p > 0):\n+                continue\n+\n+            u = np.ones(vocab_size) / vocab_size\n+            fkl = forward_kl(p, u)\n+            bkl = backward_kl(p, u)\n+\n+            error = abs(fkl - target_kl) + abs(bkl - target_kl)\n+\n+            if error < best_error:\n+                best_error = error\n+                best_dist = p.copy()\n+                best_fkl = fkl\n+                best_bkl = bkl\n+\n+                # Print if we found a good solution\n+                if error < 0.1:\n+                    print(f\"Good candidate: k={k}, alpha={alpha:.2f}\")\n+                    print(f\"  Forward KL: {fkl:.3f}, Backward KL: {bkl:.3f}\")\n+                    print(f\"  Error: {error:.6f}\")\n+\n+    return best_dist, best_fkl, best_bkl\n+\n+def create_exponential_distribution(vocab_size, target_kl=10.0):\n+    \"\"\"Try creating an exponential-like distribution\"\"\"\n+\n+    best_dist = None\n+    best_error = float('inf')\n+\n+    # Try different decay rates for exponential distribution\n+    for decay_rate in np.logspace(-3, 2, 50):  # From 0.001 to 100\n+\n+        # Create exponential distribution\n+        indices = np.arange(vocab_size)\n+        log_probs = -decay_rate * indices\n+\n+        # Convert to probabilities\n+        p = np.exp(log_probs)\n+        p = p / np.sum(p)\n+\n+        u = np.ones(vocab_size) / vocab_size\n+        fkl = forward_kl(p, u)\n+        bkl = backward_kl(p, u)\n+\n+        error = abs(fkl - target_kl) + abs(bkl - target_kl)\n+\n+        if error < best_error:\n+            best_error = error\n+            best_dist = p.copy()\n+            best_fkl = fkl\n+            best_bkl = bkl\n+\n+            if error < 0.1:\n+                print(f\"Exponential candidate: decay={decay_rate:.4f}\")\n+                print(f\"  Forward KL: {fkl:.3f}, Backward KL: {bkl:.3f}\")\n+                print(f\"  Error: {error:.6f}\")\n+\n+    return best_dist, best_fkl, best_bkl\n+\n+def find_target_distribution(vocab_size=150000, target_kl=10.0, tolerance=0.001):\n+    \"\"\"Find target distribution using analytical approaches\"\"\"\n+\n+    print(f\"Finding analytical solution for vocab_size={vocab_size}, target_kl={target_kl}\")\n+    print(f\"Tolerance: {tolerance}\")\n+\n+    # Try different analytical approaches\n+    approaches = [\n+        (\"Two-level distribution\", create_analytical_distribution),\n+        (\"Exponential distribution\", create_exponential_distribution),\n+    ]\n+\n+    best_solution = None\n+    best_error = float('inf')\n+\n+    for name, method in approaches:\n+        print(f\"\\nTrying {name}...\")\n+\n+        dist, fkl, bkl = method(vocab_size, target_kl)\n+\n+        if dist is not None:\n+            fkl_error = abs(fkl - target_kl)\n+            bkl_error = abs(bkl - target_kl)\n+            total_error = fkl_error + bkl_error\n+\n+            print(f\"  Forward KL: {fkl:.6f} (error: {fkl_error:.6f})\")\n+            print(f\"  Backward KL: {bkl:.6f} (error: {bkl_error:.6f})\")\n+            print(f\"  Total error: {total_error:.6f}\")\n+\n+            if total_error < best_error:\n+                best_error = total_error\n+                best_solution = (dist, fkl, bkl)\n+\n+                if fkl_error <= tolerance and bkl_error <= tolerance:\n+                    print(f\"Found solution within tolerance!\")\n+                    break\n+\n+    if best_solution is None:\n+        print(\"No valid solution found\")\n+        return None, 0, 0\n+\n+    p, fkl, bkl = best_solution\n+\n+    print(f\"\\n\" + \"=\"*50)\n+    print(f\"FINAL RESULTS:\")\n+    print(f\"Forward KL divergence: {fkl:.6f}\")\n+    print(f\"Backward KL divergence: {bkl:.6f}\")\n+    print(f\"Target: {target_kl}\")\n+    print(f\"Forward error: {abs(fkl - target_kl):.6f}\")\n+    print(f\"Backward error: {abs(bkl - target_kl):.6f}\")\n+    print(f\"Within tolerance: {abs(fkl - target_kl) <= tolerance and abs(bkl - target_kl) <= tolerance}\")\n+\n+    # Verify it's a valid probability distribution\n+    print(f\"\\nDistribution properties:\")\n+    print(f\"Sum of probabilities: {np.sum(p):.10f}\")\n+    print(f\"All probabilities >= 0: {np.all(p >= 0)}\")\n+    print(f\"Max probability: {np.max(p):.6f}\")\n+    print(f\"Min probability: {np.min(p):.10f}\")\n+    print(f\"Number of very small probabilities: {np.sum(p < 1e-10)}\")\n+\n+    return p, fkl, bkl\n+\n+if __name__ == \"__main__\":\n+    # Test with small vocabulary first\n+    print(\"=\" * 50)\n+    print(\"Testing analytical approach with small vocabulary (V=10)\")\n+    print(\"=\" * 50)\n+    test_dist, test_fkl, test_bkl = find_target_distribution(vocab_size=10, target_kl=10.0)\n+\n+    tolerance = 0.001\n+    target_kl = 10.0\n+\n+    if test_dist is not None and abs(test_fkl - target_kl) <= tolerance and abs(test_bkl - target_kl) <= tolerance:\n+        print(\"Small test succeeded! Proceeding with full vocabulary...\")\n+\n+        print(\"\\n\" + \"=\" * 50)\n+        print(\"Finding target distribution (V=150,000)\")\n+        print(\"=\" * 50)\n+\n+        # Find the target distribution\n+        distribution, fkl, bkl = find_target_distribution()\n+\n+        if distribution is not None and abs(fkl - target_kl) <= tolerance and abs(bkl - target_kl) <= tolerance:\n+            print(f\"\\nSuccess! Found distribution within tolerance.\")\n+            # Save the distribution\n+            np.save('/app/dist.npy', distribution)\n+            print(\"Distribution saved to /app/dist.npy\")\n+        else:\n+            print(f\"\\nFailed to find distribution within tolerance for large vocabulary.\")\n+            if distribution is not None:\n+                print(f\"Best errors - Forward: {abs(fkl - target_kl):.6f}, Backward: {abs(bkl - target_kl):.6f}\")\n+    else:\n+        print(\"Small test failed with analytical approach.\")\n+        if test_dist is not None:\n+            print(f\"Forward KL error: {abs(test_fkl - target_kl):.6f}\")\n+            print(f\"Backward KL error: {abs(test_bkl - target_kl):.6f}\")\n+\n+", "_diff_cache": null}}
