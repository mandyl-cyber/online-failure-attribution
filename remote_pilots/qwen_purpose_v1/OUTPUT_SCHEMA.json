{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "confidence",
    "abstain_reason",
    "alternatives",
    "evidence",
    "rationale"
  ],
  "properties": {
    "purpose": {
      "enum": [
        "ACQUIRE",
        "ENABLE",
        "CONSTRUCT",
        "OPERATE",
        "CHECK",
        "DELIVER",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "abstain_reason": {
      "enum": [
        "NONE",
        "CONTROL_STEP",
        "MIXED_PURPOSE",
        "INSUFFICIENT_CONTEXT",
        "CONFLICTING_EVIDENCE"
      ]
    },
    "alternatives": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACQUIRE",
          "ENABLE",
          "CONSTRUCT",
          "OPERATE",
          "CHECK",
          "DELIVER"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "field",
          "quote"
        ],
        "properties": {
          "step_id": {
            "type": "integer",
            "minimum": 0
          },
          "field": {
            "enum": [
              "task",
              "action",
              "observation",
              "public_intent"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}